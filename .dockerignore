# Prevent local history, private records, and development artifacts entering Docker build context.
.git/
.github/
.DS_Store
**/.DS_Store
__MACOSX/
**/__MACOSX/
data/
.science-env/
.venv/
**/.venv/
**/venv/
**/node_modules/
**/__pycache__/
**/*.pyc
*.zip
*.tar
*.tgz
*.log
# Docker builders use go.mod, go.sum, services/, and (for edge-daemon) scripts/.
# Exclude other root-level directories from the build context.
bff/
central-cloud/
deploy/
docs/
edge-kernel/
examples/
packages/
templates/
tests/
tools/
web/
